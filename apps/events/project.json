{
  "name": "events",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "gdg",
  "sourceRoot": "apps/events/src",
  "tags": ["type:app"],
  "implicitDependencies": ["design-system-tokens"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/events",
        "browser": "apps/events/src/main.ts",
        "tsConfig": "apps/events/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/events/public"
          }
        ],
        "styles": ["apps/events/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "events:build:production"
        },
        "development": {
          "buildTarget": "events:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "tsConfig": "apps/events/tsconfig.vitest.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "events:build",
        "staticFilePath": "dist/apps/events/browser",
        "spa": true
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx -y firebase-tools@15.30.2 deploy --only hosting --project gdg-wroclaw --non-interactive",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "preview": {
          "command": "npx -y firebase-tools@15.30.2 hosting:channel:deploy preview --project gdg-wroclaw --expires 7d --non-interactive"
        }
      }
    }
  }
}
