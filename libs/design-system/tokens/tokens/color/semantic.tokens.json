{
  "color": {
    "$type": "color",
    "background": {
      "$description": "Surfaces. The product is dark by default (Figma landing page and components).",
      "default": {
        "$value": "{color.black-02}",
        "$description": "Default page and component surface.",
        "$extensions": {
          "gdg.figma": {
            "name": "Grayscale/Black 02"
          }
        }
      },
      "disabled": {
        "$value": "{color.off-white-alpha-20}",
        "$description": "Background of disabled controls.",
        "$extensions": {
          "gdg.figma": {
            "name": "Background/Background-Disabled"
          }
        }
      },
      "nav-button-hover": {
        "$value": "{color.off-white-alpha-10}",
        "$description": "Nav Button background on hover.",
        "$extensions": {
          "gdg.figma": {
            "name": "Background/NavButton-BG-Hover"
          }
        }
      },
      "nav-button-active": {
        "$value": "{color.off-white-alpha-20}",
        "$description": "Nav Button background when it links to the current page.",
        "$extensions": {
          "gdg.figma": {
            "name": "Background/NavButton-BG-Active"
          }
        }
      },
      "raised": {
        "$value": "{color.gray-850}",
        "$description": "Cards, pills and bands that sit on the default background (Event detail page). Default content: 13.1:1; muted content: 7.8:1."
      },
      "brand-subtle": {
        "$value": "{color.navy-800}",
        "$description": "Blue-tinted labels and callouts (Event detail page). Default content: 10.7:1; brand blue secondary: 6.5:1; muted content: 6.4:1."
      }
    },
    "content": {
      "$description": "Text and icons.",
      "default": {
        "$value": "{color.off-white}",
        "$description": "Default text and icon color on dark surfaces.",
        "$extensions": {
          "gdg.figma": {
            "name": "Content/Content"
          }
        }
      },
      "disabled": {
        "$value": "{color.off-white-alpha-40}",
        "$description": "Text and icons of disabled controls.",
        "$extensions": {
          "gdg.figma": {
            "name": "Content/Content-Disabled"
          }
        }
      },
      "on-brand": {
        "$value": "{color.neutral-darkest}",
        "$description": "Text and icons on brand fills (Primary buttons): at least 4.5:1 (WCAG AA) on every brand primary and secondary fill. Deviates from Figma's Content/Content (ADR-0012)."
      },
      "error": {
        "$value": "{color.halftone-red}",
        "$description": "Validation messages. Not in Figma; halftone red keeps at least 4.5:1 (WCAG AA) on the default background."
      },
      "muted": {
        "$value": "{color.gray-300}",
        "$description": "Secondary text: descriptions, details, notes (Event detail page). 8.7:1 on the default background (WCAG AA)."
      }
    },
    "border": {
      "$description": "Strokes and dividers.",
      "default": {
        "$value": "{color.off-white}",
        "$description": "Dividers between list rows (1px).",
        "$extensions": {
          "gdg.figma": {
            "name": "Border/Border"
          }
        }
      },
      "disabled": {
        "$value": "{color.off-white-alpha-40}",
        "$description": "Border of disabled controls.",
        "$extensions": {
          "gdg.figma": {
            "name": "Border/Border-Disabled"
          }
        }
      },
      "input": {
        "$value": "{color.blue-500}",
        "$description": "Stroke of text inputs, text areas and checkboxes.",
        "$extensions": {
          "gdg.figma": {
            "name": "Colors/Brand-Blue-Primary"
          }
        }
      },
      "error": {
        "$value": "{color.halftone-red}",
        "$description": "Stroke of invalid form controls. Not in Figma."
      },
      "subtle": {
        "$value": "{color.gray-600}",
        "$description": "Low-emphasis dividers between rows and sections (Event detail page). Decorative, not a control boundary."
      }
    },
    "brand": {
      "$description": "Google brand colors. Primary is the resting state, secondary (halftone) the hover state.",
      "blue": {
        "primary": {
          "$value": "{color.blue-500}",
          "$description": "Blue brand color, resting state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Blue-Primary"
            }
          }
        },
        "secondary": {
          "$value": "{color.halftone-blue}",
          "$description": "Blue brand color, hover state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Blue-Secondary"
            }
          }
        }
      },
      "green": {
        "primary": {
          "$value": "{color.green-500}",
          "$description": "Green brand color, resting state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Green-Primary"
            }
          }
        },
        "secondary": {
          "$value": "{color.halftone-green}",
          "$description": "Green brand color, hover state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Green-Secondary"
            }
          }
        }
      },
      "yellow": {
        "primary": {
          "$value": "{color.yellow-600}",
          "$description": "Yellow brand color, resting state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Yellow-Primary"
            }
          }
        },
        "secondary": {
          "$value": "{color.halftone-yellow}",
          "$description": "Yellow brand color, hover state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Yellow-Secondary"
            }
          }
        }
      },
      "red": {
        "primary": {
          "$value": "{color.red-500}",
          "$description": "Red brand color, resting state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Red-Primary"
            }
          }
        },
        "secondary": {
          "$value": "{color.halftone-red}",
          "$description": "Red brand color, hover state.",
          "$extensions": {
            "gdg.figma": {
              "name": "Colors/Brand-Red-Secondary"
            }
          }
        }
      }
    }
  }
}
