{
  "name": "shared-ui-tokens",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui-tokens/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "generate-tokens": {
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/tokens/**/*", "{projectRoot}/tools/**/*"],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "node libs/shared/ui-tokens/tools/generate-tokens.ts"
      }
    }
  }
}
