{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-tsc/storybook",
    "tsBuildInfoFile": "out-tsc/storybook/tsconfig.storybook.tsbuildinfo",
    "types": ["node"]
  },
  "include": [".storybook/*.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/test-setup.ts"],
  "references": [{ "path": "../ui-tokens/tsconfig.lib.json" }]
}
