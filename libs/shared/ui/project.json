{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "gdg",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "storybook": {
      "executor": "@analogjs/storybook-angular:start-storybook",
      "continuous": true,
      "options": {
        "configDir": "libs/shared/ui/.storybook",
        "compodoc": false,
        "experimentalZoneless": true,
        "port": 4400
      }
    },
    "build-storybook": {
      "executor": "@analogjs/storybook-angular:build-storybook",
      "cache": true,
      "outputs": ["{options.outputDir}"],
      "inputs": ["default", "^production"],
      "options": {
        "configDir": "libs/shared/ui/.storybook",
        "compodoc": false,
        "experimentalZoneless": true,
        "outputDir": "dist/storybook/shared-ui"
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-storybook"],
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["@playwright/test"]
        }
      ],
      "options": {
        "command": "playwright test --config libs/shared/ui/playwright.config.ts"
      }
    }
  }
}
